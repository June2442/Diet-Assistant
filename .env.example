# Diet Assistant - 环境配置示例
# 复制此文件为 .env 并填写实际配置

# ============================================
# 应用配置
# ============================================
APP_NAME=Diet Assistant
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ============================================
# 数据库配置
# ============================================
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=diet_assistant
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=diet_assistant

# 数据库连接URL
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# Redis配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ============================================
# Milvus向量数据库
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=diet_assistant_memories

# ============================================
# 对象存储 (MinIO/S3)
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=diet-assistant
MINIO_USE_SSL=False

# 或者使用AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=diet-assistant

# ============================================
# LLM配置
# ============================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ============================================
# Vision/OCR配置
# ============================================
# 视觉识别服务
VISION_API_PROVIDER=openai  # openai, google, custom
VISION_MODEL=gpt-4-vision-preview

# OCR服务
OCR_PROVIDER=paddleocr  # paddleocr, tesseract, google

# ============================================
# 外部API
# ============================================
# 外卖平台API（如果有）
TAKEOUT_API_KEY=
TAKEOUT_API_ENDPOINT=

# 食物营养数据库API
NUTRITION_API_KEY=
NUTRITION_API_ENDPOINT=

# ============================================
# 安全配置
# ============================================
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CookHero集成
# ============================================
COOKHERO_ENABLED=True
COOKHERO_API_URL=http://localhost:8000
COOKHERO_API_KEY=

# ============================================
# 定时任务配置
# ============================================
# 记忆压缩任务（每日凌晨3点）
MEMORY_COMPRESSION_CRON=0 3 * * *

# 提醒检查任务（每30分钟）
REMINDER_CHECK_CRON=*/30 * * * *

# ============================================
# 监控和日志
# ============================================
# Prometheus
PROMETHEUS_PORT=9090

# 日志配置
LOG_FILE_PATH=./logs/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# ============================================
# 开发配置
# ============================================
# 开发模式下的测试用户
TEST_USER_ID=1001

# 是否启用Mock数据
USE_MOCK_DATA=True

# API速率限制
RATE_LIMIT_PER_MINUTE=60
